  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DASRogStock</DataSourceName>
        <CommandText>SELECT        Loc_TRN.LOCT_ItemID, Loc_TRN.LOCT_Location, Loc_TRN.LOCT_Qty, Loc_TRN.LOCT_DateTime, Loc_TRN.LOCT_Operation, Stock_Description.STKD_Desc
FROM            Loc_TRN, Stock_Description
WHERE        Loc_TRN.LOCT_ItemID = Stock_Description.STKD_ItemID</CommandText>
      </Query>
      <Fields>
        <Field Name="LOCT_ItemID">
          <DataField>LOCT_ItemID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOCT_Location">
          <DataField>LOCT_Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOCT_Qty">
          <DataField>LOCT_Qty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="LOCT_DateTime">
          <DataField>LOCT_DateTime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="LOCT_Operation">
          <DataField>LOCT_Operation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="STKD_Desc">
          <DataField>STKD_Desc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
