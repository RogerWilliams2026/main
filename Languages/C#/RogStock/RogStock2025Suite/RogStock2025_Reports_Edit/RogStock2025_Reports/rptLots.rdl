  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DASRogStock</DataSourceName>
        <CommandText>SELECT        Stock_Lot.LOT_Nbr, Stock_Lot.LOT_Qty, Stock_Lot.LOT_NonNet, Stock_Lot.LOT_ItemID, Stock_Lot.LOT_Location, Stock_Description.STKD_Desc
FROM            Stock_Lot, Stock_Description
WHERE        Stock_Lot.LOT_ItemID = Stock_Description.STKD_ItemID</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="LOT_Nbr">
          <DataField>LOT_Nbr</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
