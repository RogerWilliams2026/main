  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT Menu_UsersGroups.USRGRP_User,  Menu_UsersGroups.USRGRP_Group, Menu_Groups.GRP_MenuItem, Menu_MenuItems.MNU_Type, Menu_MenuItems.MNU_DisplayWhere 
FROM Menu_UsersGroups 
INNER JOIN Menu_Groups ON Menu_UsersGroups.USRGRP_Group = Menu_Groups.GRP_Group 
INNER JOIN Menu_MenuItems ON Menu_Groups.GRP_MenuItem = Menu_MenuItems.MNU_MenuItemName
ORDER BY Menu_UsersGroups.USRGRP_User, Menu_UsersGroups.USRGRP_Group, Menu_MenuItems.MNU_DisplayWhere, Menu_MenuItems.MNU_Type, Menu_MenuItems.MNU_MenuItemName;</CommandText>
      </Query>
      <Fields>
        <Field Name="USRGRP_User">
          <DataField>USRGRP_User</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="USRGRP_Group">
