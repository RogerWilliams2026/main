  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DASRogStock</DataSourceName>
        <CommandText>SELECT        Lot_TRN.LOTT_Qty, Lot_TRN.LOTT_DateTime, Lot_TRN.LOTT_ItemID, Lot_TRN.LOTT_Location, Lot_TRN.LOTT_Operation, Lot_TRN.LOTT_Nbr, Stock_Description.STKD_Desc
FROM            Lot_TRN, Stock_Description
WHERE        Lot_TRN.LOTT_ItemID = Stock_Description.STKD_ItemID</CommandText>
      </Query>
      <Fields>
        <Field Name="LOTT_Qty">
          <DataField>LOTT_Qty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="LOTT_DateTime">
          <DataField>LOTT_DateTime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="LOTT_ItemID">
          <DataField>LOTT_ItemID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOTT_Location">
          <DataField>LOTT_Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOTT_Operation">
          <DataField>LOTT_Operation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOTT_Nbr">
          <DataField>LOTT_Nbr</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="STKD_Desc">
          <DataField>STKD_Desc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
