  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DASRogStock</DataSourceName>
        <CommandText>SELECT        Stock_Items.STKI_ItemID, Stock_Items.STKI_LocLot, Stock_Items.STKI_Price, Stock_Items.STKI_ProductFamily, Stock_Items.STKI_UOM, Stock_Description.STKD_Desc, Stock_Description.STKD_LongDesc, 
                         Stock_Media.STKM_Path, Stock_Media.STKM_Type
FROM            Stock_Items, Stock_Description, Stock_Media
WHERE        Stock_Items.STKI_ItemID = Stock_Description.STKD_ItemID AND Stock_Items.STKI_ItemID = Stock_Media.STKM_ItemID</CommandText>
      </Query>
      <Fields>
        <Field Name="STKI_ItemID">
          <DataField>STKI_ItemID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
