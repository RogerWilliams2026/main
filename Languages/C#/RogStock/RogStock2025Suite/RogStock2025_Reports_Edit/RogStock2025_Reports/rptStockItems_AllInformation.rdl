          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!STKI_ItemID.Value</FilterExpression>
          <Operator>Equal</Operator>
          <FilterValues>
            <FilterValue>=Parameters!ItemID.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
