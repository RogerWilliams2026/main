  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT        Stock_Items.STKI_ItemID, Stock_Items.STKI_ProductFamily, Stock_Items.STKI_LocLot, Stock_Items.STKI_UOM, Stock_Items.STKI_Price, Stock_Description.STKD_Desc, Loc_TRN.LOCT_DateTime, Loc_TRN.LOCT_Location, 
                         Loc_TRN.LOCT_Qty, Loc_TRN.LOCT_Operation
FROM          Loc_TRN INNER JOIN
                         Stock_Description ON Loc_TRN.LOCT_ItemID = Stock_Description.STKD_ItemID INNER JOIN
                         Stock_Items ON Stock_Description.STKD_ItemID = Stock_Items.STKI_ItemID</CommandText>
      </Query>
      <Fields>
        <Field Name="STKI_ItemID">
          <DataField>STKI_ItemID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
