  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DASRogStock</DataSourceName>
        <CommandText>SELECT        Stock_Loc.LOC_Location, Stock_Loc.LOC_ItemID, Stock_Loc.LOC_Qty, Stock_Loc.LOC_NonNet, Stock_Loc.LOC_Description, Stock_Description.STKD_Desc
FROM            Stock_Loc, Stock_Description
WHERE        Stock_Loc.LOC_ItemID = Stock_Description.STKD_ItemID</CommandText>
      </Query>
      <Fields>
        <Field Name="LOC_Location">
          <DataField>LOC_Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOC_ItemID">
          <DataField>LOC_ItemID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOC_Qty">
          <DataField>LOC_Qty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="LOC_NonNet">
          <DataField>LOC_NonNet</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="LOC_Description">
          <DataField>LOC_Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="STKD_Desc">
          <DataField>STKD_Desc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
