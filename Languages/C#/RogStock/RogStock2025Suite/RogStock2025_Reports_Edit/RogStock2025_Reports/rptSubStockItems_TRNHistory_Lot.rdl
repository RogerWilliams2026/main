          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        LOTT_ItemID, LOTT_Location, LOTT_Nbr, LOTT_DateTime, LOTT_Qty, LOTT_Operation
FROM            Lot_TRN WHERE LOTT_ItemID = @ItemID AND LOTT_Location = @Location</CommandText>
      </Query>
